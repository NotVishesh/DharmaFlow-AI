# DharmaFlow AI .gitignore

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
config/client_secret.json
config/youtube_token.json
config/instagram_token.json
*.token.json
secrets/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
pip-wheel-metadata/
*.pth

# ── Database ──────────────────────────────────────────────────────────────────
data/*.db
data/*.db-shm
data/*.db-wal

# ── Output & Generated Content ────────────────────────────────────────────────
output/
temp/
logs/

# ── AI Models (large binaries) ────────────────────────────────────────────────
*.ckpt
*.safetensors
*.onnx
*.bin
*.pt
*.pth
models/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS ────────────────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini

# ── Tests ─────────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak

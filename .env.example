# DharmaFlow AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to source control.

# ── Application ───────────────────────────────────────────────────────────────
DHARMAFLOW_ENV=development          # development | production
DHARMAFLOW_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
DHARMAFLOW_HOST=127.0.0.1
DHARMAFLOW_PORT=8000
DHARMAFLOW_DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/dharmaflow.db

# ── LLM Provider (choose one or configure in config.yaml) ────────────────────
# Local (default — no key needed, uses Ollama or llama-cpp-python)
LLM_PROVIDER=local
LOCAL_LLM_MODEL=llama3.2:3b          # Ollama model tag

# OpenAI (optional — set LLM_PROVIDER=openai to activate)
OPENAI_API_KEY=sk-...

# Anthropic (optional — set LLM_PROVIDER=anthropic to activate)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (optional — set LLM_PROVIDER=gemini to activate)
GOOGLE_API_KEY=AIza...

# ── Visual Generation ─────────────────────────────────────────────────────────
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_ENABLED=false               # set true when ComfyUI is running

# ── Text-to-Speech ────────────────────────────────────────────────────────────
TTS_PROVIDER=gtts                   # gtts (free, online) | piper (local) | kokoro (local)
TTS_LANGUAGE=hi                     # hi | en | hi-en (hinglish)
PIPER_MODEL_PATH=                   # path to .onnx model file
KOKORO_MODEL_PATH=                  # path to kokoro voice model

# ── YouTube ───────────────────────────────────────────────────────────────────
# Create credentials at https://console.developers.google.com/
# Download client_secret.json and place it in config/
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secret.json
YOUTUBE_TOKEN_FILE=config/youtube_token.json
YOUTUBE_DEFAULT_PRIVACY=private     # private | unlisted | public
YOUTUBE_DAILY_UPLOAD_LIMIT=1
YOUTUBE_ENABLED=false

# ── Instagram (optional) ──────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ENABLED=false

# ── Content & Safety ──────────────────────────────────────────────────────────
REQUIRE_HUMAN_APPROVAL=true
DAILY_VIDEO_LIMIT=1
TIMEZONE=Asia/Kolkata
SAFE_MODE=true                      # enforces all hard checks; never disable for public content

# ── Storage ───────────────────────────────────────────────────────────────────
OUTPUT_DIR=output
LOGS_DIR=logs
MAX_STORAGE_GB=50
TEMP_DIR=temp

# ── Cost Caps ─────────────────────────────────────────────────────────────────
MONTHLY_API_SPEND_CAP_USD=10.0      # set 0 to disable external LLM usage
